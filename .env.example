# ============================================================
# Variables de entorno requeridas para el backend - Biblioteca IA
# ============================================================
# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas el archivo .env a Git.

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/biblioteca
DB_USERNAME=tu_usuario_aqui
DB_PASSWORD=tu_contraseña_aqui

# API Key de Google Gemini (para el chatbot de recomendaciones de libros)
# Consíguela gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
